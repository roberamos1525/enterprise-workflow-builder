# Copy to .env (or export) — never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# SQLite file (directory is created automatically)
DATABASE_PATH=var/ewb.db
# Required in production, >= 32 chars. Without it, development uses an ephemeral random secret.
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_TTL_SECONDS=28800
LOG_LEVEL=info
# Serve the built UI from the API server (production)
WEB_DIST=apps/web/dist
# Max JSON request body
BODY_LIMIT_BYTES=1048576
# HTTP action egress policy: private/loopback/link-local are blocked unless allow-listed
HTTP_ALLOW_LIST=
HTTP_ALLOW_PRIVATE=false
HTTP_MAX_RESPONSE_BYTES=1048576
# Default per-attempt step timeout
STEP_TIMEOUT_MS=300000
# What to do with schedules missed while the server was down: fire_once | skip
SCHEDULER_MISFIRE=fire_once
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Optional JSON config file with the same keys in camelCase (env vars win)
# EWB_CONFIG=config.json
